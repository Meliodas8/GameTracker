<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="dev.manel.gametracker.ui.SettingsController">
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT">
            <Label text="%settings.title" styleClass="topbar-title"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 16;">

                <!-- Arranque con el sistema -->
                <VBox styleClass="settings-section" spacing="8">
                    <Label text="%settings.section.system" styleClass="settings-section-title"/>
                    <HBox styleClass="settings-row" alignment="CENTER_LEFT" spacing="12">
                        <VBox HBox.hgrow="ALWAYS" spacing="2">
                            <Label text="%settings.autostart"
                                   styleClass="settings-label"/>
                            <Label text="%settings.autostart.desc"
                                   styleClass="settings-description"/>
                        </VBox>
                        <CheckBox fx:id="chkAutostart" onAction="#onAutostartChanged"/>
                    </HBox>
                </VBox>

                <!-- Tema visual e idioma -->
                <VBox styleClass="settings-section" spacing="8">
                    <Label text="%settings.section.appearance" styleClass="settings-section-title"/>
                    <HBox styleClass="settings-row" alignment="CENTER_LEFT" spacing="12">
                        <VBox HBox.hgrow="ALWAYS" spacing="2">
                            <Label text="%settings.theme" styleClass="settings-label"/>
                            <Label text="%settings.theme.desc"
                                   styleClass="settings-description"/>
                        </VBox>
                        <ComboBox fx:id="themeSelector" onAction="#onThemeChanged"/>
                    </HBox>
                    <HBox styleClass="settings-row" alignment="CENTER_LEFT" spacing="12">
                        <VBox HBox.hgrow="ALWAYS" spacing="2">
                            <Label text="%settings.language" styleClass="settings-label"/>
                            <Label text="%settings.language.desc"
                                   styleClass="settings-description"/>
                        </VBox>
                        <ComboBox fx:id="languageSelector" onAction="#onLanguageChanged"/>
                    </HBox>
                </VBox>

                <!-- Actualizaciones -->
                <VBox styleClass="settings-section" spacing="8">
                    <Label text="%settings.section.updates" styleClass="settings-section-title"/>
                    <HBox styleClass="settings-row" alignment="CENTER_LEFT" spacing="12">
                        <VBox HBox.hgrow="ALWAYS" spacing="2">
                            <Label fx:id="versionLabel" styleClass="settings-label"/>
                            <Label fx:id="updateStatusLabel" styleClass="settings-description"/>
                        </VBox>
                        <Button fx:id="checkUpdateBtn" text="%settings.checkUpdates"
                                onAction="#onCheckUpdate"/>
                    </HBox>
                </VBox>

                <!-- Apps manuales -->
                <VBox styleClass="settings-section" spacing="8">
                    <Label text="%settings.section.manualApps"
                           styleClass="settings-section-title"/>
                    <HBox alignment="CENTER_RIGHT">
                        <Button text="%settings.newApp" onAction="#openAddAppDialog"/>
                    </HBox>
                    <ListView fx:id="manualAppsList" prefHeight="200"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
